<Project Sdk="Microsoft.NET.Sdk">
  <!-- Kompiliert dieselben Quelldateien wie Unity (Assets/...), damit Assembly-Grenzen auch ohne Unity geprüft werden. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/WorldBeyond/Simulation/Systems/**/*.cs" />
    <ProjectReference Include="../WorldBeyond.Simulation.Core/WorldBeyond.Simulation.Core.csproj" />
    <ProjectReference Include="../WorldBeyond.Content/WorldBeyond.Content.csproj" />
  </ItemGroup>
</Project>
